<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>JetBlue vs USAir Cup</title>
<style>
:root{
  --navy:#0a3161;
  --navy-dark:#072348;
  --navy-light:#14457f;
  --jb:#0033a0;
  --jb-bg:#e8eefb;
  --ua:#c41e3a;
  --ua-bg:#fdeaee;
  --green:#1e7d33;
  --green-bg:#e6f4e9;
  --gold:#f5b80c;
  --bg:#eef1f5;
  --card:#ffffff;
  --border:#d7dde6;
  --text:#1c2733;
  --muted:#5d6b7c;
  --faint:#94a1b2;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);font-size:15px}

/* ===== Header ===== */
.hdr{background:var(--navy);color:#fff;padding:0}
.hdr-top{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 8px}
.hdr-title{font-size:17px;font-weight:700;letter-spacing:.3px}
.hdr-title .vs{color:var(--gold);font-weight:400;font-size:13px;margin:0 4px}
.hdr-sub{font-size:11px;color:#a9bdd6;letter-spacing:.5px;text-transform:uppercase}
.hdr-score{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0px 16px 12px;gap:8px}
.hs-team{display:flex;flex-direction:column;text-align:center}
.hs-team.r{text-align:center}
.hs-name{font-size:12px;font-weight:600;letter-spacing:.5px;text-transform:uppercase}
.hs-name.jb{color:#7fa8ff}
.hs-name.ua{color:#ff8fa0}
.hs-pts{font-size:30px;font-weight:700;line-height:1.1;color:#fff}
.hs-mid{text-align:center;font-size:10px;color:#7e92ad;text-transform:uppercase;letter-spacing:.5px}
.hs-needed{font-size:10px;color:#a9bdd6;margin-top:2px}
.tabs{display:flex;background:var(--navy-dark)}
.tab{flex:1;padding:11px 4px;text-align:center;font-size:12px;font-weight:600;letter-spacing:.4px;text-transform:uppercase;color:#8da4c2;border:none;background:transparent;cursor:pointer;border-bottom:3px solid transparent}
.tab.on{color:#fff;border-bottom-color:var(--gold)}

/* ===== Layout ===== */
.wrap{max-width:760px;margin:0 auto;padding:12px 12px 40px}
.banner{background:#fff8e1;border:1px solid #f0d68a;color:#7a5d00;font-size:12px;padding:10px 12px;border-radius:6px;margin-bottom:12px;line-height:1.5}
.banner.ok{background:var(--green-bg);border-color:#bfe3c6;color:var(--green)}
.banner b{font-weight:700}

/* ===== Session pills ===== */
.sess-row{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:4px}
.sess-pill{flex-shrink:0;padding:7px 13px;border-radius:16px;border:1px solid var(--border);background:var(--card);font-size:12px;font-weight:600;color:var(--muted);cursor:pointer;white-space:nowrap}
.sess-pill.on{background:var(--navy);border-color:var(--navy);color:#fff}
.sess-pill .d{font-weight:400;opacity:.75;font-size:11px}

/* ===== Cards / tables ===== */
.card{background:var(--card);border:1px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:10px}
.card-hd{background:#f4f6f9;border-bottom:1px solid var(--border);padding:8px 12px;display:flex;align-items:center;justify-content:space-between}
.card-hd .t{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.sess-meta{font-size:12px;color:var(--muted);margin:6px 2px 10px}

.match-row{display:flex;align-items:stretch;border-bottom:1px solid #edf0f4;cursor:pointer;background:var(--card)}
.match-row:last-child{border-bottom:none}
.match-row:active{background:#f4f6f9}
.mr-num{width:34px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--faint);background:#f8fafc;border-right:1px solid #edf0f4}
.mr-body{flex:1;padding:9px 10px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:6px}
.mr-side{min-width:0}
.mr-side.r{text-align:right}
.mr-p{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mr-p.jb{color:var(--jb)}
.mr-p.ua{color:var(--ua)}
.mr-p2{font-size:13.5px;font-weight:700}
.mr-status{text-align:center;min-width:74px}
.pill{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border-radius:11px;letter-spacing:.3px;white-space:nowrap}
.pill.jb{background:var(--jb-bg);color:var(--jb)}
.pill.ua{background:var(--ua-bg);color:var(--ua)}
.pill.half{background:#eceff3;color:var(--muted)}
.pill.pend{background:transparent;color:var(--faint);border:1px dashed var(--border);font-weight:600}
.pill.live{background:var(--green-bg);color:var(--green)}
.mr-thru{font-size:10px;color:var(--faint);margin-top:2px}
.mr-tee{font-size:10px;font-weight:700;letter-spacing:.4px;color:var(--muted);margin-bottom:3px;white-space:nowrap}
.mr-tee.none{color:var(--faint);font-weight:600}

/* ===== Scorecard ===== */
.sc-top{padding:12px;background:var(--card);border:1px solid var(--border);border-radius:8px;margin-bottom:10px}
.back{display:inline-flex;align-items:center;gap:5px;background:none;border:none;color:var(--navy);font-size:13px;font-weight:600;cursor:pointer;padding:0;margin-bottom:8px}
.sc-fmt{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.sc-fmt .tee{color:var(--navy)}
.sc-vs{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;margin-top:6px}
.sc-team{font-size:14px;font-weight:700;line-height:1.35}
.sc-team.jb{color:var(--jb)}
.sc-team.ua{color:var(--ua);text-align:right}
.sc-status{display:flex;align-items:center;justify-content:space-between;background:var(--navy);color:#fff;border-radius:6px;padding:9px 12px;margin-top:10px}
.sc-status .lbl{font-size:11px;letter-spacing:.5px;text-transform:uppercase;color:#a9bdd6}
.sc-status .val{font-size:15px;font-weight:700}
.fmt-note{font-size:11.5px;color:var(--muted);margin-top:8px;line-height:1.5}

.holes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
@media(min-width:560px){.holes{grid-template-columns:repeat(4,1fr)}}
.hole{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:8px;text-align:center}
.hole.won-jb{border-color:var(--jb);box-shadow:inset 0 0 0 1px var(--jb)}
.hole.won-ua{border-color:var(--ua);box-shadow:inset 0 0 0 1px var(--ua)}
.hole.won-half{border-color:#b8c2cf;box-shadow:inset 0 0 0 1px #b8c2cf}
.hole-num{font-size:10px;font-weight:700;letter-spacing:.5px;color:var(--faint);text-transform:uppercase;margin-bottom:5px}
.hole-in{display:flex;flex-direction:column;gap:5px}
.hrow{display:flex;align-items:center;gap:5px}
.hlbl{font-size:10px;font-weight:700;width:20px;text-align:left}
.hlbl.jb{color:var(--jb)}
.hlbl.ua{color:var(--ua)}
.hinp{flex:1;height:38px;font-size:17px;font-weight:600;text-align:center;border:1px solid var(--border);border-radius:6px;background:#fafbfc;color:var(--text);width:100%}
.hinp:focus{outline:none;border-color:var(--navy);background:#fff}
.hwin{font-size:10px;font-weight:700;height:14px;margin-top:2px}
.hwin.jb{color:var(--jb)}
.hwin.ua{color:var(--ua)}
.hwin.half{color:var(--faint)}

/* ===== Scoreboard ===== */
.total-card{background:var(--navy);border-radius:8px;color:#fff;padding:14px 16px;margin-bottom:14px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
.tc-pts{font-size:36px;font-weight:700;line-height:1}
.tc-name{font-size:12px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;margin-bottom:3px}
.tc-mid{text-align:center;font-size:10px;color:#7e92ad;text-transform:uppercase;letter-spacing:.5px}
.sb-tbl{width:100%;border-collapse:collapse;font-size:13px}
.sb-tbl td{padding:8px 10px;border-bottom:1px solid #edf0f4;vertical-align:middle}
.sb-tbl tr:last-child td{border-bottom:none}
.sb-side{width:38%}
.sb-side.r{text-align:right}
.sb-p{font-weight:600;font-size:12.5px;line-height:1.4}
.sb-p.jb{color:var(--jb)}
.sb-p.ua{color:var(--ua)}
.sb-mid{text-align:center;width:24%}
.sess-pts{font-size:12px;font-weight:700;color:var(--muted)}

/* ===== Admin ===== */
.alogin{max-width:300px;margin:36px auto;text-align:center}
.alogin input{width:100%;padding:11px;border:1px solid var(--border);border-radius:6px;font-size:15px;margin:10px 0;text-align:center}
.btn{display:inline-block;padding:10px 18px;border-radius:6px;border:1px solid var(--navy);background:var(--navy);color:#fff;font-size:13px;font-weight:600;cursor:pointer;letter-spacing:.3px}
.btn.ghost{background:transparent;color:var(--navy)}
.btn.danger{background:transparent;border-color:#d8a0a9;color:var(--ua)}
.btn.sm{padding:6px 12px;font-size:12px}
.btn:active{transform:scale(.98)}
.atabs{display:flex;gap:6px;margin-bottom:12px}
.atab{padding:7px 13px;border-radius:16px;border:1px solid var(--border);background:var(--card);font-size:12px;font-weight:600;color:var(--muted);cursor:pointer}
.atab.on{background:var(--navy);border-color:var(--navy);color:#fff}
.roster-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:540px){.roster-grid{grid-template-columns:1fr}}
.r-col-hd{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;padding:8px 10px;border-radius:6px 6px 0 0;color:#fff}
.r-col-hd.jb{background:var(--jb)}
.r-col-hd.ua{background:var(--ua)}
.r-col{background:var(--card);border:1px solid var(--border);border-radius:0 0 6px 6px;padding:8px}
.r-row{display:flex;align-items:center;gap:6px;margin-bottom:5px}
.r-row span{font-size:10px;color:var(--faint);width:16px;text-align:right;font-weight:700}
.r-row input{flex:1;padding:7px 9px;border:1px solid var(--border);border-radius:5px;font-size:13px;background:#fafbfc}
.r-row input:focus{outline:none;border-color:var(--navy);background:#fff}
.pair-card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px}
.pair-hd{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
.pair-num{font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--faint)}
.tee-row{display:flex;align-items:center;gap:6px}
.tee-row label{font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--faint)}
.tee-row input{width:110px;padding:6px 8px;border:1px solid var(--border);border-radius:5px;font-size:12.5px;font-weight:600;background:#fafbfc;text-align:center}
.tee-row input:focus{outline:none;border-color:var(--navy);background:#fff}
.tee-row input::placeholder{color:var(--faint);font-weight:600;font-style:italic}
.pair-sel{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.pair-sel.singles{grid-template-columns:1fr 1fr}
.pair-sel select{width:100%;padding:8px 6px;border:1px solid var(--border);border-radius:5px;font-size:12.5px;background:#fafbfc;font-weight:600}
.pair-sel select.jb{color:var(--jb)}
.pair-sel select.ua{color:var(--ua)}
.pair-vs{grid-column:1/-1;text-align:center;font-size:10px;color:var(--faint);font-weight:700;letter-spacing:1px;padding:1px 0}
.reset-row{display:flex;align-items:center;justify-content:space-between;background:var(--card);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;font-size:13px;font-weight:600}
.save-bar{position:sticky;bottom:0;background:linear-gradient(transparent,var(--bg) 30%);padding:14px 0 6px;display:flex;gap:8px;align-items:center}
.savemsg{font-size:12px;color:var(--green);font-weight:600}
.conn{position:fixed;bottom:10px;right:10px;font-size:10px;font-weight:700;letter-spacing:.4px;padding:4px 10px;border-radius:12px;z-index:50}
.conn.on{background:var(--green-bg);color:var(--green)}
.conn.off{background:#fdeaee;color:var(--ua)}
.empty{padding:28px;text-align:center;color:var(--faint);font-size:13px}
</style>
</head>
