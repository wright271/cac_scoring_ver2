function defaultState(){
  const jb = Array.from({length:16},(_,i)=>`JetBlue Player ${i+1}`);
  const ua = Array.from({length:16},(_,i)=>`USAir Player ${i+1}`);
  const pairings = {};
  SESSIONS.forEach(s=>{
    const n = s.team ? 8 : 16;
    pairings[s.id] = Array.from({length:n},(_,i)=> s.team
      ? {jb1:jb[i*2], jb2:jb[i*2+1], ua1:ua[i*2], ua2:ua[i*2+1], tee: s.tee?'':undefined, scores:{jb:{},ua:{}}}
