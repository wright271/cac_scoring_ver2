let state = defaultState();
let db = null, ref = null, online = false;
const localMode = firebaseConfig.apiKey.indexOf("PASTE") === 0;

function setConn(on, txt){
  const el = document.getElementById('conn');
  el.className = 'conn ' + (on ? 'on' : 'off');
  el.textContent = txt;
}

if (!localMode){
  try{
    firebase.initializeApp(firebaseConfig);
    db = firebase.database();
    ref = db.ref('tournament');
    ref.on('value', snap=>{
      const v = snap.val();
      if (v === null){ ref.set(state); return; }
      const incoming = JSON.stringify(normalize(v));
      if (incoming === JSON.stringify(state)) return;
      state = normalize(v);
      renderPreservingFocus();
    });
    db.ref('.info/connected').on('value', s=>{
      online = !!s.val();
      setConn(online, online ? 'LIVE SYNC' : 'OFFLINE — RETRYING');
    });
  }catch(e){
    setConn(false,'SYNC ERROR');
  }
} else {
  try{ const s = localStorage.getItem('golfcup'); if (s) state = normalize(JSON.parse(s)); }catch(e){}
  setConn(false,'LOCAL ONLY — NO SYNC');
}

/* Firebase drops empty objects, so re-hydrate the shape */
function normalize(v){
  const st = v || {};
  st.jb = arr16(st.jb, i=>`JetBlue Player ${i+1}`);
  st.ua = arr16(st.ua, i=>`USAir Player ${i+1}`);
  st.pairings = st.pairings || {};
  SESSIONS.forEach(s=>{
    const n = s.team ? 8 : 16;
    let arr = st.pairings[s.id];
    if (!arr) arr = [];
    if (!Array.isArray(arr)) arr = Object.keys(arr).sort((a,b)=>a-b).map(k=>arr[k]);
