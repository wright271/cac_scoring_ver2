      const m = arr[i] || {};
      return {
        jb1:m.jb1||'', jb2: s.team ? (m.jb2||'') : undefined,
        ua1:m.ua1||'', ua2: s.team ? (m.ua2||'') : undefined,
        tee: s.tee ? (m.tee||'') : undefined,
        scores:{ jb:(m.scores&&m.scores.jb)||{}, ua:(m.scores&&m.scores.ua)||{} }
      };
    });
  });
  return st;
}
